# awg-exporter configuration (systemd EnvironmentFile). Values below are defaults.

# Seconds between `awg show` polls
AWG_EXPORTER_SCRAPE_INTERVAL=60

# Metrics HTTP listener (only in "http" mode)
AWG_EXPORTER_HTTP_HOST=127.0.0.1
AWG_EXPORTER_HTTP_PORT=9351
AWG_EXPORTER_OPS_MODE=http

# Docker container running AmneziaWG
AWG_CONTAINER_NAME=amnezia-awg
AWG_EXPORTER_AWG_SHOW_EXEC="wg show all"

# Resolve peer keys to client names via the Amnezia clients table inside the container
AWG_EXPORTER_CLIENTS_TABLE_ENABLED=true
AWG_EXPORTER_CLIENTS_TABLE_FILE=/opt/amnezia/awg/clientsTable

# Docker socket (default /var/run/docker.sock)
#DOCKER_HOST=unix:///var/run/docker.sock

# Go soft memory limit (default 10MiB)
#GOMEMLIMIT=10MiB
